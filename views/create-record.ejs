<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Employee Record</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container my-5">
    <h1 class="text-center">Create Employee Record</h1>
    <div class="row justify-content-center">
      <div class="col-md-6">
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <form action="/create-record" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input id="name" type="text" name="name" class="form-control" maxlength="200" value="<%= values.name %>" required>
          </div>
          <div class="mb-3">
            <label for="employee_id" class="form-label">Employee ID</label>
            <input id="employee_id" type="text" name="employee_id" class="form-control" maxlength="100" value="<%= values.employee_id %>" required>
          </div>
          <div class="mb-3">
            <label for="role" class="form-label">Role <span class="text-muted">(optional)</span></label>
            <input id="role" type="text" name="role" class="form-control" maxlength="200" value="<%= values.role %>">
          </div>
          <button type="submit" class="btn btn-success w-100">Save Record</button>
        </form>
        <div class="text-center">
          <a href="/" class="btn btn-secondary">Back to Records</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
