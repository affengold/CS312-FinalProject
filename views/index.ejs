<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employee Records</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container my-5">
    <h1 class="text-center">Employee Records</h1>

    <div class="text-center mb-4">
      <a href="/create-record" class="btn btn-success">Create Record</a>
    </div>

    <form action="/" method="GET" class="mb-4">
      <label for="search" class="form-label">Search by name or employee ID</label>
      <div class="input-group">
        <input id="search" type="search" name="search" class="form-control" value="<%= search %>" placeholder="Enter a name or employee ID">
        <button type="submit" class="btn btn-primary">Search</button>
        <% if (search) { %>
          <a href="/" class="btn btn-outline-secondary">Clear</a>
        <% } %>
      </div>
    </form>

    <div class="row mt-4">
      <% if (records.length === 0) { %>
        <div class="col-12">
          <p class="text-center text-muted"><%= search ? 'No records match your search.' : 'No employee records have been added yet.' %></p>
        </div>
      <% } %>
      <% records.forEach(record => { %>
        <div class="col-md-12 my-3">
          <div class="card">
            <div class="card-body">
              <h2 class="h5 card-title"><%= record.name %></h2>
              <p class="card-text"><strong>Employee ID:</strong> <%= record.employee_id %></p>
              <p class="card-text"><strong>Role:</strong> <%= record.role || 'Not specified' %></p>
              <p class="text-muted mb-0"><small>Added: <%= new Date(record.created_at).toLocaleString() %></small></p>
              <div class="mt-3">
                <a href="/edit-record/<%= record.record_id %>" class="btn btn-primary">Edit</a>
                <form action="/delete-record/<%= record.record_id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this employee record?');">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
